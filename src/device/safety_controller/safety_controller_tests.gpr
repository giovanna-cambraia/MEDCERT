with "safety_controller.gpr";

project Safety_Controller_Tests is

   for Languages use ("C");
   for Source_Dirs use ("tests");
   for Object_Dir use "tests/obj";
   for Exec_Dir use "tests/bin";
   for Main use ("test_safety_controller.c");

   package Compiler is
      for Default_Switches ("C") use
       ("-Wall", "-Wextra", "-std=c11", "-pedantic",
         "-DSC_MAX_DOSE_PER_CYCLE=100u",
         "-I" & Safety_Controller.Include_Dir);
   end Compiler;

end Safety_Controller_Tests;
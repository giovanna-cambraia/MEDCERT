project Safety_Controller is

   for Languages use ("C");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";

   Include_Dir := "include";

   package Naming is
      for Spec_Suffix ("C") use ".h";
      for Body_Suffix ("C") use ".c";
   end Naming;

   package Compiler is
      for Default_Switches ("C") use
        ("-Wall", "-Wextra", "-std=c11", "-pedantic",
         "-DSC_MAX_DOSE_PER_CYCLE=100u", "-I" & Include_Dir);
   end Compiler;

end Safety_Controller;